!function(){try{window.didomiRemoteConfig={"notices":[{"notice_id":"a69YJ7Ci","default":false,"platform":"web","targets":["immobiliare.it","mutuiamo.it","*.immobiliare.it"],"config":{"app":{"name":"Immobiliare.it","vendors":{"iab":{"all":false,"stacks":{"ids":[],"auto":true},"enabled":true,"exclude":[],"include":[1126,132,16,42,164,358,32,793,91],"version":2,"minorVersion":2,"restrictions":[{"id":"QUGKCMxM","vendors":{"ids":[],"type":"all"},"purposeId":"market_research","restrictionType":"req-consent"},{"id":"EMEtkqbY","vendors":{"ids":[],"type":"all"},"purposeId":"measure_content_performance","restrictionType":"req-consent"},{"id":"XxhCwVUd","vendors":{"ids":[],"type":"all"},"purposeId":"improve_products","restrictionType":"req-consent"},{"id":"pDmwJR7e","vendors":{"ids":[],"type":"all"},"purposeId":"market_research","restrictionType":"req-consent"},{"id":"RKUFdf4T","vendors":{"ids":[],"type":"all"},"purposeId":"measure_ad_performance","restrictionType":"req-consent"},{"id":"Yif9JFR7","vendors":{"ids":[],"type":"all"},"purposeId":"select_basic_ads","restrictionType":"req-consent"}],"gvlSpecificationVersion":3},"didomi":["twitter","facebook","google"],"custom":[{"id":"linkedin-marketing-solutions","didomiId":"linkedin-marketing-solutions","name":"LinkedIn Ireland (Marketing Solutions)","policyUrl":"https://www.linkedin.com/legal/privacy-policy","purposeIds":["cookies","create_ads_profile","create_content_profile","improve_products","market_research","measure_ad_performance","measure_content_performance","select_basic_ads","select_personalized_ads","select_personalized_content"],"legIntPurposeIds":[],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[]},{"id":"reddit","didomiId":"reddit","name":"Reddit","policyUrl":"https://www.reddit.com/help/privacypolicy","purposeIds":["cookies","create_ads_profile","create_content_profile","improve_products","market_research","measure_ad_performance","measure_content_performance","select_basic_ads","select_personalized_ads","select_personalized_content"],"legIntPurposeIds":[],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[]},{"id":"trovit-Thrdj63x","didomiId":"trovit-Thrdj63x","name":"TROVIT","policyUrl":"https://corporate.trovit.com/politica-de-privacidad","purposeIds":["cookies","create_ads_profile","select_personalized_ads"],"legIntPurposeIds":["improve_products","market_research","measure_ad_performance","select_basic_ads"],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[],"namespaces":{"google":{"id":1107,"current":true}}},{"id":"snapinc-yhYnJZfT","didomiId":"snapinc-yhYnJZfT","name":"Snap Inc.","policyUrl":"https://www.snap.com/en-US/privacy/privacy-policy/","purposeIds":["cookies","create_ads_profile","select_personalized_ads"],"legIntPurposeIds":["improve_products","market_research","measure_ad_performance","select_basic_ads"],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[],"namespaces":{"google":{"id":2572,"current":true}}},{"id":"tiktok-KZAUQLZ9","didomiId":"tiktok-KZAUQLZ9","name":"TikTok","policyUrl":"https://www.tiktok.com/legal/privacy-policy?appLaunch=app&lang=en","purposeIds":["cookies","create_ads_profile","create_content_profile","device_characteristics","geolocation_data","improve_products","market_research","measure_ad_performance","measure_content_performance","select_basic_ads","select_personalized_ads","select_personalized_content"],"legIntPurposeIds":[],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[]},{"id":"googleana-4TXnJigR","didomiId":"googleana-4TXnJigR","name":"Google Analytics Products","policyUrl":"https://business.safety.google/privacy/","purposeIds":["cookies","measure_content_performance"],"legIntPurposeIds":[],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[]},{"id":"microsoft","didomiId":"microsoft","name":"Microsoft (Bing Ads)","policyUrl":"https://privacy.microsoft.com/en-us/privacystatement","purposeIds":["cookies","create_ads_profile","create_content_profile","improve_products","market_research","measure_ad_performance","measure_content_performance","select_basic_ads","select_personalized_ads","select_personalized_content"],"legIntPurposeIds":[],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[]},{"id":"pinterest","didomiId":"pinterest","name":"Pinterest","policyUrl":"https://policy.pinterest.com/fr/privacy-policy","purposeIds":["cookies","create_ads_profile","create_content_profile","improve_products","market_research","measure_ad_performance","measure_content_performance","select_basic_ads","select_personalized_ads","select_personalized_content"],"legIntPurposeIds":[],"usesNonCookieAccess":false,"type":"3rd_party","lang_urls":[]}],"google":{"fullATP":true}},"privacyPolicyURL":"https://www.immobiliare.it/terms/privacy/","essentialPurposes":[],"gdprAppliesGlobally":true,"gdprAppliesWhenUnknown":false,"apiKey":"ccbb9faf-6f3a-4699-a499-e08dec395373","deploymentId":"NwzeCdVZ","country":"it","consentDuration":15811200,"deniedConsentDuration":15811200},"user":{"bots":{"consentRequired":false},"country":"IT","region":"65"},"theme":{"css":"#didomi-host .didomi-notice-banner {\n    background-color: #00406a !important;\n    color: white !important;\n    left: 16px !important;\n    right: 16px !important;\n    bottom: 16px !important;\n    border-radius: 8px !important;\n    padding: 10px !important;\n    margin: auto !important;\n    max-width: 1280px !important;\n}\n\n#didomi-host .didomi-notice-banner .didomi-notice-text {\n  font-size: 14px !important;\n}\n\n#didomi-host .didomi-notice-banner .didomi-notice-text a:not(.didomi-no-link-style) {\n    text-decoration: underline;\n    color: #fff !important;\n}\n\n#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-standard,\n#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-highlight {\n  border: none !important;\n  background-color: transparent !important;\n  color: white !important;\n  text-transform: uppercase !important;\n  border-radius: 4px !important;\n  line-height: normal !important;\n  height: 40px !important;\n}\n\n#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-standard:hover {\n  background-color: rgba(0,0,0,.06) !important;\n}\n\n#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-highlight {\n  background-color: #FFFFFF !important;\n  color: #0074c1 !important;\n}\n\n#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-highlight:hover {\n  background-color: #EEF2F5 !important;\n  }\n  \n .didomi-notice-data-processing-container .didomi-notice-data-processing-title,\n .didomi-notice-data-processing-container .didomi-notice-data-processing-list {\nfont-weight: normal !important;\ncolor: #9FA5B6 !important;\n}\n\n/*.didomi-continue-without-agreeing {\n    font-size: 13px !important;\n    position: absolute;\n    top: 8px!important;\n    right: auto!important;\n}*/\n\n#didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice.bottom, #didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice.bottom .didomi-notice__interior-border {\n    border-top-width: 0 !important;\n}\n\n#didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice .didomi-notice__interior-border {\n    display: flex;\n    padding: 0 !important;\n}\n\n#didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice #text {\n    width: auto !important;\n}\n\n#didomi-host #didomi-notice.didomi-regular-notice #buttons button {\n    font-size: 14px !important;\n    min-width: 88px !important;\n}\n\n#didomi-host #buttons #didomi-notice-learn-more-button>span {\n    white-space: nowrap !important;\n}\n\n#didomi-host .didomi-notice-data-processing-container {\n    text-align: left !important;\n}\n\n#didomi-host .didomi-mobile .didomi-notice-data-processing-container .didomi-notice-data-processing-list, #didomi-host .didomi-mobile .didomi-notice-data-processing-container .didomi-notice-data-processing-title {\n    font-size: 12px !important;\n    line-height: 140% !important;\n}\n\n/* Move didomi-continue-without-agreeing to the bottom */\n#didomi-host .didomi-notice-banner .didomi-continue-without-agreeing {\n  font-size: 13px !important;\n  top: auto !important;\n  bottom: 12px;\n  right: auto !important;\n  text-decoration: none;\n}\n\n#didomi-host .didomi-notice-banner {\n  padding-bottom: 40px !important;\n}\n\n#didomi-host .didomi-mobile .didomi-notice-banner {\n  padding-bottom: 10px !important;\n}\n\n#didomi-host .didomi-mobile .didomi-notice-banner{padding-bottom:10px!important}.didomi-mobile .didomi-continue-without-agreeing{order:1; align-self:flex-start !important}.didomi-mobile .didomi-banner-notice-continue-without-agreeing-buttons{order:2}\n\n#didomi-host .didomi-popup-notice .didomi-popup-notice-logo {\n    width: 400px !important;\n}\n\n#didomi-host .didomi-popup-container {\nbackground-color: #1a3c4e !important;\ncolor: white !important;\n}\n\n#didomi-host .didomi-popup-container.didomi-consent-popup__dialog {\nbackground-color: #fff !important;\ncolor: black !important;\n}\n\n#didomi-host .didomi-popup-container .didomi-notice-text {\nfont-size: 14px !important;\n}\n\n#didomi-host .didomi-popup-container .didomi-buttons .didomi-button-standard,\n#didomi-host .didomi-popup-container .didomi-buttons .didomi-button-highlight {\nborder: none !important;\nbackground-color: transparent !important;\ncolor: white !important;\ntext-transform: uppercase !important;\nborder-radius: 4px !important;\nline-height: normal !important;\nheight: 40px !important;\n}\n\n#didomi-host .didomi-popup-container.didomi-consent-popup__dialog .didomi-buttons .didomi-button-standard,\n#didomi-host .didomi-popup-container.didomi-consent-popup__dialog .didomi-buttons .didomi-button-highlight {\nborder: 1px solid rgba(34, 34, 34, 0.2) !important;\nbackground-color: transparent !important;\ncolor: #0074c1 !important;\ntext-transform: uppercase !important;\nborder-radius: 4px !important;\nline-height: normal !important;\nheight: 40px !important;\n}\n\n#didomi-host .didomi-popup-container .didomi-buttons .didomi-button-standard:hover {\nbackground-color: rgba(0,0,0,.06) !important;\n}\n\n#didomi-host .didomi-popup-container .didomi-buttons .didomi-button-highlight {\nbackground-color: #FFFFFF !important;\ncolor: #0074c1 !important;\n}\n\n#didomi-host .didomi-popup-container.didomi-consent-popup__dialog .didomi-buttons .didomi-button-highlight {\n    background-color: #0074c1 !important;\n    color: #FFFFFF !important;\n}\n\n#didomi-host .didomi-popup-container .didomi-buttons .didomi-button-highlight:hover {\nbackground-color: #EEF2F5 !important;\n}\n\n#didomi-host .didomi-popup-container.didomi-consent-popup__dialog .didomi-buttons .didomi-button-highlight:hover {\nbackground-color: #006AB0 !important;\n}\n\n.didomi-notice-data-processing-container .didomi-notice-data-processing-title,\n.didomi-notice-data-processing-container .didomi-notice-data-processing-list {\nfont-weight: normal !important;\ncolor: #9FA5B6 !important;\n}\n\n/* Move didomi-continue-without-agreeing to the bottom */\n#didomi-host .didomi-popup-container .didomi-continue-without-agreeing {\n  font-size: 13px !important;\n  top: auto !important;\n  bottom: 12px;\n  right: auto !important;\n}\n#didomi-host .didomi-popup-notice.didomi-popup-notice-with-data-processing {\n    padding: 24px !important;\n}\n\n#didomi-host .didomi-popup-notice .didomi-popup-notice-subtext, #didomi-host .didomi-popup-notice .didomi-popup-notice-text {\n    max-width: 100%;\n}\n\n#didomi-host .didomi-mobile #didomi-popup .didomi-popup-notice p {\n    text-align: left !important;\n}\n\n#didomi-host .didomi-mobile .didomi-popup-notice-text p span {\n    font-size: 14px !important;\n}\n\n#didomi-host .didomi-popup-notice-text p { font-size: 14px; } \n\n#didomi-host .didomi-popup-notice-text p span { font-size: 14px; }\n\n#didomi-host .didomi-notice-banner .didomi-notice-text p {\n    display: contents;\n}\n","font":"system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif","color":"#0074c1","linkColor":"#0074c1"},"notice":{"content":{"notice":{"de":"Mit Ihrer Zustimmung verwenden wir und <a href=\"javascript:Didomi.preferences.show('vendors')\">unsere Partner</a> Cookies oder ähnliche Technologien, um personenbezogene Daten wie Website-Besuche, IP-Adressen und eindeutige IDs in Cookies zu speichern, darauf zuzugreifen und sie zu verarbeiten, um ein Profil zu erstellen, das mit folgenden Aspekten zusammenhängt: Bewertung von Anzeigen und Inhalten, Beobachtung der Zielgruppe und Produktentwicklung, Speicherung von und/oder Zugriff auf Informationen auf einem Gerät, personalisierte Anzeigen und Inhalte. Einige Partner benötigen Ihre Zustimmung nicht und berufen sich auf ein berechtigtes Interesse. Sie können Ihre Einwilligung jederzeit widerrufen oder die Datenverarbeitung auf der Grundlage eines berechtigten Interesses ablehnen, indem Sie auf \"Mehr infos” oder auf der Seite zur <a href=\"https://www.immobiliare.it/de/terms/cookie/\">Verwendung von Cookies</a> klicken. Wenn Sie auf \"Weiter ohne Zustimmung\" klicken, können Sie nur mit technischen und analytischen Cookies weitersurfen, aber Sie werden kein optimales Surferlebnis haben.","el":"Με τη συγκατάθεσή σας, εμείς και οι <a href=\"javascript:Didomi.preferences.show('vendors')\">Συνεργάτες μας</a> χρησιμοποιούμε cookies ή παρόμοιες τεχνολογίες για την αποθήκευση, πρόσβαση και επεξεργασία προσωπικών δεδομένων, όπως επισκέψεις στον ιστότοπο, διευθύνσεις IP και μοναδικά αναγνωριστικά σε cookies, για σκοπούς κατάρτισης προφίλ που σχετίζονται με: αξιολόγηση διαφημίσεων και περιεχομένου, παρατήρηση κοινού και ανάπτυξη προϊόντων, αποθήκευση ή/και πρόσβαση σε πληροφορίες σε μια συσκευή, εξατομικευμένες διαφημίσεις και περιεχόμενο. Ορισμένοι Συνεργάτες δεν απαιτούν τη συγκατάθεσή σας και βασίζονται στο έννομο συμφέρον. Μπορείτε ανά πάσα στιγμή να ανακαλέσετε τη συγκατάθεσή σας ή να αρνηθείτε την επεξεργασία δεδομένων που βασίζεται σε έννομο συμφέρον, κάνοντας κλικ στο \"Μάθετε περισσότερα\" ή από τη σελίδα <a href=\"https://www.immobiliare.it/el/terms/cookie/\">Χρήση των cookies</a>. Κάνοντας κλικ στην επιλογή \"Συνεχίστε χωρίς να συμφωνείτε\" θα μπορέσετε να συνεχίσετε την περιήγηση μόνο με τεχνικά και αναλυτικά cookies, ωστόσο δε θα απολαμβάνετε τη βέλτιστη εμπειρία περιήγησης.","en":"With your consent, we and <a href=\"javascript:Didomi.preferences.show('vendors')\">our partners</a> use cookies or similar technologies to store, access, and process personal data such as website visits, IP addresses, and unique IDs in cookies, for profiling purposes related to: evaluating listings and content, audience observations and product development, storing and/or accessing the information on a device, personalized ads and content. Some Partners do not require your consent and rely on legitimate interest. You can withdraw consent or decline data processing based on legitimate interest at any time by clicking \"Learn more\" or from the <a href=\"https://www.immobiliare.it/en/terms/cookie/\">Use of Cookies</a> page. Clicking \"Continue without accepting\" will allow you to continue browsing with only technical and analytical cookies, however, you will not enjoy an optimal browsing experience.","es":"Con su consentimiento, nosotros y <a href=\"javascript:Didomi.preferences.show('vendors')\">nuestros socios</a> utilizamos cookies o tecnologías similares para almacenar, acceder y procesar datos personales como visitas al sitio web, direcciones IP e identificadores únicos en cookies, con fines de elaboración de perfiles relacionados con: evaluación de anuncios y contenidos, observación de audiencias y desarrollo de productos, almacenamiento y/o acceso a información en un dispositivo, anuncios y contenidos personalizados. Algunos Socios no requieren su consentimiento y se basan en el interés legítimo. Puede retirar su consentimiento o rechazar el tratamiento de datos basado en el interés legítimo, en cualquier momento, haciendo clic en \"Más información\" o desde la página de <a href=\"https://www.immobiliare.it/es/terms/cookie/\">Uso de Cookies</a>. Si hace clic en \"Continuar sin aceptar\", podrá seguir navegando solo con cookies técnicas y analíticas, aunque no disfrutará de una experiencia de navegación óptima.","fr":"Avec votre consentement, nous et <a href=\"javascript:Didomi.preferences.show('vendors')\">nos partenaires</a> utilisons des cookies ou des techniques similaires pour stocker, accéder et traiter des données personnelles telles que les visites sur le site web, les adresses IP et les identifiants uniques dans les cookies, à des fins de profilage liées à : l'évaluation des publicités et du contenu, l'observation de l'audience et le développement de produits, le stockage et/ou l'accès aux informations sur un appareil, les publicités et le contenu personnalisés. Certains partenaires n'ont pas besoin de votre consentement et se fondent sur l'intérêt légitime. Vous pouvez retirer votre consentement ou refuser le traitement des données fondé sur l'intérêt légitime, à tout moment, en cliquant sur “En savoir plus\" ou à partir de la page <a href=\"https://www.immobiliare.it/fr/terms/cookie/\">Utilisation des cookies</a>. En cliquant sur \"Continuer sans accepter\", vous pourrez continuer à naviguer en utilisant uniquement des cookies techniques et analytiques, mais vous ne bénéficierez pas d'une expérience de navigation optimale.","it":"Con il tuo consenso, noi e <a href=\"javascript:Didomi.preferences.show('vendors')\">i nostri partner</a> usiamo cookie o tecnologie simili per archiviare, accedere ed elaborare dati personali come visite al sito web, indirizzi IP e ID univoci nei cookie, con finalità di profilazione relative a: valutazione degli annunci e del contenuto, osservazioni del pubblico e sviluppo di prodotti, archiviare e/o accedere a informazioni su un dispositivo, annunci e contenuti personalizzati. Alcuni Partner non richiedono il tuo consenso e fanno affidamento sull'interesse legittimo. Puoi ritirare il consenso o rifiutare l'elaborazione dei dati in base al legittimo interesse, in ogni momento, facendo clic su \"Più informazioni\" o dalla pagina <a href=\"https://www.immobiliare.it/terms/cookie/\">Uso dei Cookie</a>. Facendo clic su “Continua senza accettare” potrai continuare la navigazione con i soli cookie tecnici e analitici, tuttavia non godrai di una esperienza ottimale di navigazione.","pt":"Com o seu consentimento, nós e os <a href=\"javascript:Didomi.preferences.show('vendors')\">nossos parceiros</a> utilizamos cookies ou tecnologias semelhantes para armazenar, aceder e processar dados pessoais, tais como visitas a sítios web, endereços IP e identificações únicas em cookies, para fins de criação de perfis relacionados com: avaliação de anúncios e conteúdos, observação de audiências e desenvolvimento de produtos, armazenamento e/ou acesso a informações num dispositivo, anúncios e conteúdos personalizados. Alguns Parceiros não necessitam do seu consentimento e confiam no interesse legítimo. Pode retirar o seu consentimento ou recusar o processamento de dados com base no interesse legítimo em qualquer altura, clicando em “Saiba mais” ou na página <a href=\"https://www.immobiliare.it/pt/terms/cookie/\">Uso de Cookie</a>. Clicar em \"Continuar sem aceitar\" permitir-lhe-á continuar a navegação apenas com cookies técnicos e analíticos, contudo, não desfrutará de uma experiência de navegação otimizada.","ru":"С вашего согласия мы и <a href=\"javascript:Didomi.preferences.show('vendors')\">наши Партнеры</a> используем файлы cookie или аналогичные технологии для хранения, доступа и обработки персональных данных, таких как посещения сайта, IP-адреса и уникальные идентификаторы в файлах cookie, в целях профилирования, связанных с: оценкой рекламы и контента, наблюдением за аудиторией и разработкой продуктов, хранением и/или доступом к информации на устройстве, персонализированной рекламой и контентом. Некоторые Партнеры не требуют вашего согласия и полагаются на законный интерес. Вы можете отозвать согласие или отказаться от обработки данных на основании законного интереса в любое время, нажав кнопку \"Подробнее\" или на странице <a href=\"https://www.immobiliare.it/ru/terms/cookie/\">Использование cookie</a>. Нажав кнопку \"Продолжить без согласия\", вы сможете продолжить просмотр сайта, используя только технические и аналитические файлы cookie, однако при этом вы не сможете насладиться оптимальными возможностями просмотра."},"dismiss":{"en":"Agree & Close","it":"Accetta"},"learnMore":{"de":"Mehr Infos","el":"Μάθετε περισσότερα","en":"Learn More","es":"Más información","fr":"En savoir plus","it":"Più informazioni"}},"position":"bottom","closeOnClick":true,"closeOnScroll":false,"showDataProcessing":false,"closeOnScrollThreshold":0,"daysBeforeShowingAgain":"180","closeOnScrollThresholdType":"","closeOnClickNavigationDelay":"10","enableBulkActionOnPurposes":true,"partnersLink":{"enabled":true},"type":"optin","denyOptions":{"link":true,"cross":false,"button":"none"},"denyAsLink":true,"denyAppliesToLI":true},"languages":{"default":"it","enabled":["en","fr","de","el","it","pt","ru","es"]},"tagManager":{"provider":"gtm"},"preferences":{"content":{"text":{"de":"Unsere Partner und wir verwenden Cookies und Daten Ihres Geräts, die nicht vertraulich sind, um unsere Produkte zu verbessern und Werbung sowie weitere Inhalte auf dieser Website zu personalisieren. Sie können diese Vorgänge komplett oder teilweise akzeptieren. Lesen Sie unsere <a href=\"{privacyPolicyURL}\" target=\"_blank\">Datenschutzrichtlinie</a>, um mehr über Cookies, unsere Partner, unsere Verwendung Ihrer Daten und Ihre Optionen bezüglich dieser Vorgänge bei jedem Partner zu erfahren.","el":"Εμείς και οι συνεργάτες μας τοποθετούμε cookies, έχουμε πρόσβαση και κάνουμε χρήση μη ευαίσθητων πληροφοριών από τη συσκευή σας για να βελτιώνουμε τα προϊόντα μας και να εξατομικεύουμε διαφημίσεις και άλλο περιεχόμενο σε αυτόν τον ιστότοπο. Μπορείτε να αποδεχτείτε τις λειτουργίες αυτές εν μέρει ή στο σύνολό τους. Για να μάθετε περισσότερα για τα cookies, τους συνεργάτες μας και πώς χρησιμοποιούμε τα δεδομένα σας, καθώς και να εξετάσετε τις επιλογές σας ή τις εν λόγω λειτουργίες ανά συνεργάτη, ανατρέξτε στην <a href=\"{privacyPolicyURL}\" target=\"_blank\">πολιτική απορρήτου</a> μας.","en":"We and our partners place cookies, access and use non-sensitive information from your device to improve our products and personalize ads and other contents throughout this website. You may accept all or part of these operations. To learn more about cookies, partners, and how we use your data, to review your options or these operations for each partner, visit our <a href=\"{privacyPolicyURL}\" target=\"_blank\">privacy policy</a>.","es":"Nosotros y nuestros socios colocamos cookies, accedemos y usamos información no sensible de su dispositivo para mejorar nuestros productos y personalizar anuncios y otros contenidos en este sitio web. Usted puede aceptar todas o parte de estas operaciones. Para obtener más información sobre las cookies, los socios y cómo usamos sus datos, para revisar sus opciones o estas operaciones para cada socio, visite nuestra <a href=\"{privacyPolicyURL}\" target=\"_blank\"> política de privacidad </a>.","fr":"Nos partenaires et nous déposons des cookies et utilisons des informations non sensibles de votre appareil pour améliorer nos produits et afficher des publicités et contenus personnalisés. Vous pouvez accepter ou refuser ces différentes opérations. Pour en savoir plus sur les cookies, les données que nous utilisons, les traitements que nous réalisons et les partenaires avec qui nous travaillons, vous pouvez consulter notre <a href=\"{privacyPolicyURL}\" target=\"_blank\">politique de confidentialité</a>.","it":"Noi e i nostri partner inseriamo cookie, accediamo e utilizziamo informazioni non sensibili presenti nel tuo dispositivo per migliorare i nostri prodotti e personalizzare gli annunci e altri contenuti in questo sito. Puoi accettare tutte o parte di queste operazioni. Per ulteriori informazioni su cookie, partner e su come utilizziamo i tuoi dati, per conoscere le tue opzioni o queste operazioni per ciascun partner, visita la nostra <a href=\"{privacyPolicyURL}\" target=\"_blank\">Informativa sulla privacy</a>.","pt":"Nós e os nossos parceiros colocamos cookies, acedemos e utilizamos informações não confidenciais do seu dispositivo para melhorar os nossos produtos e personalizar anúncios e outros conteúdos neste Website. Pode aceitar estas operações parcial ou integralmente. Para saber mais acerca dos cookies, dos parceiros e como utilizamos os seus dados, assim como para rever as suas opções ou estas operações para cada parceiro, consulte a nossa <a href=\"{privacyPolicyURL}\" target=\"_blank\">Política de Privacidade</a>.","ru":"Вместе с нашими партнерами мы создаем файлы cookie, получаем и используем неконфиденциальные данные с вашего устройства в целях совершенствования наших продуктов, а также персонализации рекламы и прочих материалов на данном веб-сайте. Вы можете разрешить выполнение всех этих действий или только некоторых из них. Подробные сведения о файлах cookie, партнерах и процедуре использования ваших данных, а также перечень ваших возможностей или доступных действий для каждого партнера представлены в нашей <a href=\"{privacyPolicyURL}\" target=\"_blank\">Политике конфиденциальности</a>."},"title":{"de":"Einstellungen zu Cookies","el":"Προτιμήσεις cookies","en":"Cookie preferences","es":"Configuración de cookies","fr":"Préférences en matière de cookies","it":"Le tue preferenze per i cookie","pt":"Preferências para cookies","ru":"Предпочтения для cookie"},"textVendors":{"de":"Sie können die Zustimmungseinstellungen für jeden der nachfolgenden Partner einzeln festlegen. Klicken Sie auf einen Partnernamen, um mehr darüber zu erfahren, was er macht, welche Daten erfasst werden und wie diese Daten verwendet werden.","el":"Μπορείτε να ρυθμίσετε τις προτιμήσεις συγκατάθεσης για κάθε συνεργάτη που αναφέρεται πιο κάτω ξεχωριστά. Πατήστε στο όνομα ενός συνεργάτη για να αποκτήσετε περισσότερες πληροφορίες για το τι κάνει, ποια δεδομένα συλλέγει και πώς τα χρησιμοποιεί.","en":"You can set your consent preferences for every partner listed below individually. Click on a partner name to get more information on what it does, what data it is collecting and how it is using it.","es":"Puede configurar sus preferencias de consentimiento de forma individual para cada socio de la lista de abajo. Haga clic en el nombre del socio para obtener más información acerca de lo que hace, qué datos recopila y cómo los usa.","fr":"Vous pouvez définir vos préférences de consentement pour chaque partenaire listé ci-dessous individuellement. Cliquez sur le nom d'un partenaire pour obtenir plus d'informations sur ce qu'il fait, les données qu'il récolte et comment il les utilise.","it":"È possibile impostare le preferenze di consenso singolarmente per ogni partner elencato di seguito. Fai clic sul nome di un partner per ottenere maggiori informazioni su cosa fa, quali dati sta raccogliendo e come li sta usando.","pt":"Pode definir individualmente as suas preferências de autorização para cada parceiro indicado abaixo. Clique no nome de um parceiro para obter mais informações acerca das respetivas ações, que dados recolhe e como os utiliza.","ru":"Вы можете указать свои предпочтения отдельно для каждого из перечисленных ниже партнеров. Щелкните имя партнера для получения подробной информации о том, чем он занимается, какие данные собирает и как их использует."}},"categories":[{"type":"purpose","purposeId":"cookies"},{"type":"purpose","purposeId":"measure_content_performance"},{"type":"purpose","purposeId":"create_ads_profile"},{"type":"purpose","purposeId":"create_content_profile"},{"type":"purpose","purposeId":"improve_products"},{"type":"purpose","purposeId":"market_research"},{"type":"purpose","purposeId":"measure_ad_performance"},{"type":"purpose","purposeId":"select_basic_ads"},{"type":"purpose","purposeId":"select_personalized_content"},{"type":"purpose","purposeId":"select_personalized_ads"},{"type":"purpose","purposeId":"device_characteristics"},{"type":"purpose","purposeId":"geolocation_data"},{"type":"purpose","purposeId":"use_limited_data_to_select_content"}],"showWhenConsentIsMissing":false,"storageDisclosure":{"enable":true},"vendorsCount":{"enabled":true},"vendorsDisclosure":{"enabled":true},"denyAppliesToLI":true},"regulations":{},"integrations":{"vendors":{"google":{"enable":true,"refresh":true,"eprivacy":false,"passTargetingVariables":false},"salesforce-dmp":{"enable":false,"namespace":null},"refreshOnConsent":false,"gcm":{"enable":true,"setDefaultStatus":true,"dataLayerName":null,"defaultStatus":{"analytics":true,"ad":true,"functionality":true,"personalization":true,"security":true,"ad_user_data":true,"ad_personalization":true}}}},"regulation":{"name":"gdpr","group":{"name":"optin"}},"id":"2a39f9d2-02fb-4d77-80ec-3efa2fbccc2f","version":"1.0.0","experiment":{"id":"test-notice-format","size":0,"config":{"theme":{"css":"#didomi-host #didomi-notice{background-color:#1a3c4e!important}#didomi-host .didomi-notice-banner{background-color:#1a3c4e!important;color:#fff!important;left:16px!important;right:16px!important;bottom:16px!important;border-radius:8px!important;padding:10px 10px 40px!important;margin:auto!important;max-width:1280px!important}#didomi-host .didomi-notice-banner .didomi-notice-text{font-size:14px!important}#didomi-host .didomi-notice-banner .didomi-notice-text a:not(.didomi-no-link-style){text-decoration:underline;color:#fff!important}#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-highlight,#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-standard{border:none!important;background-color:transparent!important;color:#fff!important;text-transform:uppercase!important;border-radius:4px!important;line-height:normal!important;height:40px!important}#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-standard:hover{background-color:rgba(0,0,0,.06)!important}#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-highlight{background-color:#fff!important;color:#2b6482!important}#didomi-host .didomi-notice-banner .didomi-buttons .didomi-button-highlight:hover{background-color:#eef2f5!important}.didomi-notice-data-processing-container .didomi-notice-data-processing-list,.didomi-notice-data-processing-container .didomi-notice-data-processing-title{font-weight:400!important;color:#9fa5b6!important}#didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice.bottom,#didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice.bottom .didomi-notice__interior-border{border-top-width:0!important}#didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice .didomi-notice__interior-border{display:flex;padding:0!important}#didomi-host .didomi-mobile #didomi-notice.didomi-regular-notice #text{width:auto!important}#didomi-host #didomi-notice.didomi-regular-notice #buttons button{font-size:14px!important;min-width:88px!important}#didomi-host #buttons #didomi-notice-learn-more-button>span{white-space:nowrap!important}#didomi-host .didomi-notice-data-processing-container{text-align:left!important}#didomi-host .didomi-notice-banner .didomi-continue-without-agreeing{font-size:13px!important;top:auto!important;bottom:12px;right:auto!important;text-decoration:none}#didomi-host .didomi-mobile .didomi-notice-banner{padding-bottom:10px!important}.didomi-mobile .didomi-continue-without-agreeing{order:1; align-self:flex-start !important}.didomi-mobile .didomi-banner-notice-continue-without-agreeing-buttons{order:2}"}},"startDate":"2023-03-03T23:38:50Z"}}}]}}catch(o){console.error("Didomi - Invalid remote config")}}();!function(){try{window.didomiCountry="IT",window.didomiRegion="65",window.didomiGeoRegulations=["gdpr"]}catch(o){console.error("Didomi - Invalid country")}}();!function(){var t,e={190:func